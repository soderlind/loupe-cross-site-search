# Files and directories excluded from the distributed plugin zip / wp.org payload.
# Consumed via rsync --exclude-from in the build-zip workflows.

# Version control / CI / editor
.distignore
.git/
.github/
.gitignore
.gitattributes
.editorconfig
.DS_Store
.playwright-mcp/

# Linting config (GitHub-only)
.markdownlint.json
.markdownlintignore

# Tests
tests/
phpunit.xml.dist
.phpunit.cache/

# JS tooling (the block ships prebuilt, hand-written JS — no build output needed)
node_modules/
package.json
package-lock.json
vitest.config.js

# Composer manifests (the build ships vendor/ from `composer install --no-dev`).
composer.json
composer.lock

# Composer autoloader is unused (classes are required directly); don't ship it.
vendor/autoload.php
vendor/composer/

# Bundled Action Scheduler ships, but not its dev / test / CI files.
vendor/woocommerce/action-scheduler/.github/
vendor/woocommerce/action-scheduler/tests/
vendor/woocommerce/action-scheduler/docs/
vendor/woocommerce/action-scheduler/bin/
vendor/woocommerce/action-scheduler/phpunit.xml.dist
vendor/woocommerce/action-scheduler/composer.json
vendor/woocommerce/action-scheduler/package.json
vendor/woocommerce/action-scheduler/*.md
vendor/woocommerce/action-scheduler/*.yml
vendor/woocommerce/action-scheduler/*.dist

# Documentation (GitHub-only; readme.txt is kept for wp.org)
README.md
CHANGELOG.md
CONTEXT.md
docs/
